# التطبيق
NODE_ENV=development
NEXT_PUBLIC_APP_NAME=Adaptive Learning System
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# قاعدة البيانات
DATABASE_URL=mysql://user:password@localhost:3306/adaptive_learning

# التخزين والملفات
STORAGE_ENDPOINT=
STORAGE_BUCKET=adaptive-learning
STORAGE_REGION=auto
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=

# البث المباشر
AGORA_APP_ID=
AGORA_APP_CERTIFICATE=

# الاتصال اللحظي
NEXT_PUBLIC_SOCKET_URL=http://localhost:3001

# البريد والإشعارات
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Adaptive Learning <no-reply@example.com>"
